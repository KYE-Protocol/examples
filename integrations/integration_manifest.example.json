{
  "schema": "https://kyeprotocol.com/schemas/kye.integration_manifest.v1.json",
  "schema_version": "1.0.0",
  "manifest_id": "kye:manifest:integrations-example",
  "adopted_at": "2026-05-30",
  "description": "Reference fixture for kye.integration_manifest.v1. Shows three minimal-but-complete integration entries (one outbound payment, one inbound KMS signer, one Integration Catalog model/inference target) covering every required field plus the optional Integration Catalog fields (relationship_type, host_kind, readiness_status). Validates against the schema in CI.",
  "constitution_ref": "constitution/16-EDGE-RUNTIME.md §11",
  "publication_rule": {
    "policy": "private",
    "rationale": "Example fixture parallels the live manifest publication policy."
  },
  "integrations": [
    {
      "id": "kye:integration:example-stripe",
      "name": "Stripe (example)",
      "provider": "Stripe, Inc.",
      "category": "payment",
      "dictionary_term": "stripe",
      "workers_using": ["kye:worker:commercial-lifecycle-worker"],
      "endpoints_provided": ["POST /v1/webhooks/stripe"],
      "outbound_endpoints_called": ["https://api.stripe.com"],
      "required_for_surfaces": ["app"],
      "secrets_required": ["STRIPE_API_KEY", "STRIPE_WEBHOOK_SECRET"],
      "rate_limit_quota": { "limit": 100, "period": "second", "burst": 25 },
      "cost_model": { "pricing_model": "per_event" },
      "circuit_breaker_config": { "failure_threshold": 5, "window_seconds": 60, "cooldown_seconds": 30, "half_open_probe": true },
      "fallback_behavior": "queue_for_retry",
      "data_residency_constraints": ["us", "eu"],
      "status": "active"
    },
    {
      "id": "kye:integration:example-aws-kms",
      "name": "AWS KMS (example)",
      "provider": "Amazon Web Services",
      "category": "kms",
      "dictionary_term": "aws-kms",
      "workers_using": ["kye:worker:authority-proof-bundle-worker"],
      "endpoints_provided": [],
      "outbound_endpoints_called": ["https://kms.us-east-1.amazonaws.com"],
      "required_for_surfaces": ["app"],
      "secrets_required": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_KMS_KEY_ARN"],
      "rate_limit_quota": { "limit": 1200, "period": "second" },
      "cost_model": { "pricing_model": "per_signature", "unit_cost_usd": 0.00003 },
      "fallback_behavior": "switch_to_alternate_provider",
      "data_residency_constraints": ["us", "eu"],
      "status": "active"
    },
    {
      "id": "kye:integration:example-cohere",
      "name": "Cohere (example)",
      "provider": "Cohere Inc.",
      "category": "model-inference",
      "host_kind": "model-inference",
      "relationship_type": "authority-adapter",
      "dictionary_term": "cohere",
      "workers_using": [],
      "endpoints_provided": [],
      "outbound_endpoints_called": [],
      "required_for_surfaces": ["none"],
      "secrets_required": [],
      "rate_limit_quota": { "limit": 0, "period": "second", "notes": "Live per-tenant API rate limits apply downstream; the catalog row sets no quota of its own." },
      "cost_model": { "pricing_model": "free", "notes": "Integration Catalog listing — KYE governs the action, not the model." },
      "fallback_behavior": "fail_closed",
      "data_residency_constraints": ["tenant_specific"],
      "readiness_status": "declared-not-wired",
      "status": "active",
      "notes": "Integration Catalog model/inference target (§0.25). KYE governs the data + purpose binding at inference and seals an Evidence Pack before the call commits. Live per-tenant API wiring is declared-not-wired (creds not in-repo)."
    }
  ]
}
