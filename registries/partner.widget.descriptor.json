{
  "$schema": "https://kyeprotocol.com/schemas/kye.partner.widget.descriptor.v1.json",
  "slug": "decision-map",
  "name": "Decision Map Widget",
  "version": "v1",
  "iframe_url_template": "https://widgets.kyeprotocol.com/decision-map/v1{?decision-id,deployment_id,theme,density,locale,env}",
  "web_component_tag": "kye-decision-map",
  "required_purpose_class": "kye:purpose-class:decision.map.read",
  "data_classes": [
    "decision_map",
    "audit_event_chain"
  ],
  "theming_hooks": [
    "--kye-color-surface",
    "--kye-color-accent",
    "--kye-shadow-md"
  ],
  "audit_events": [
    "decision.map.view",
    "decision.map.export",
    "kye.widget.ready",
    "kye.widget.action.expand_node",
    "kye.widget.action.export_map",
    "kye.widget.action.view_signal"
  ],
  "csp": {
    "connect_src": [
      "https://api.kyeprotocol.com"
    ],
    "frame_ancestors": [
      "*"
    ]
  },
  "auditor_only": false,
  "control_mappings": {
    "eu_ai_act_art_50": "Identity strip in first paint declares widget name and purpose; non-dismissable.",
    "gdpr_art_13": "Data classes (decision_map, audit_event_chain) disclosed in descriptor before any input field is enabled.",
    "psd2_sca": "N/A — read-only, non-payment-initiation surface.",
    "nist_ai_rmf_map_5": "Audit events list enumerates every emission the widget makes.",
    "iso_42001_a_7_4": "Embed contract and data classes are documented for the deploying organisation."
  },
  "postmessage": {
    "ready": {
      "type": "kye.widget.ready"
    },
    "action": {
      "type": "kye.widget.action",
      "kinds": [
        "expand_node",
        "export_map",
        "view_signal"
      ]
    },
    "revoke": null
  }
}
