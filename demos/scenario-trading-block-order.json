    "context": { "instrument": "EQ:BP.L", "side": "sell", "amount": 4200000 }
  },
  "expected": { "decision": "require_approval", "reason_code": "approval_threshold_breach" },
  "tags": ["trading", "order-execution", "approval-threshold"]
