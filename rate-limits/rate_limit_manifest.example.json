{
  "$schema": "https://kyeprotocol.com/schemas/kye.rate_limit_manifest.v1.json",
  "schema": "kye.rate_limit_manifest.v1",
  "version": "1.0",
  "generated_at": "2026-05-30T00:00:00Z",
  "constitution_ref": "constitution/16-EDGE-RUNTIME.md#2.3",
  "notes": [
    "Illustrative example of a kye.rate_limit_manifest.v1 instance. Carries two rules covering one read class + one write class. The canonical full registry lives at internal"
  ],
  "rules": [
    {
      "id": "kye:rate-limit:example_read",
      "description": "Example read class.",
      "endpoint_patterns": ["/v1/example/:id"],
      "methods": ["GET"],
      "tier_limits": {
        "free":       { "requests_per_window": 60,   "window_seconds": 60, "burst_allowance": 20 },
