        "enterprise": { "requests_per_window": 6000, "window_seconds": 60, "burst_allowance": 2000 },
        "internal":   { "requests_per_window": 0,    "window_seconds": 60 }
      },
      "quota_scope": "per_tenant",
      "over_limit_response_code": 429,
      "retry_after_strategy": "token_bucket_drain",
      "effective_from": "2026-05-30"
    },
    {
      "id": "kye:rate-limit:example_write",
      "description": "Example write class with SKU binding.",
      "endpoint_patterns": ["/v1/example"],
      "methods": ["POST"],
      "tier_limits": {
        "free":       { "requests_per_window": 5,   "window_seconds": 60 },
        "pro":        { "requests_per_window": 30,  "window_seconds": 60 },
        "enterprise": { "requests_per_window": 300, "window_seconds": 60, "burst_allowance": 50, "concurrency_limit": 10 },
        "internal":   { "requests_per_window": 0,   "window_seconds": 60 }
      },
      "quota_scope": "per_api_key",
      "over_limit_response_code": 429,
      "retry_after_strategy": "exponential",
      "pricing_tier_ref": "kye:sku:KYE-STARTER-ANNUAL-001",
      "effective_from": "2026-05-30"
    }
  ]
